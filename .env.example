# Environment Configuration Template (Rename to .env for local overrides)

# Base Paths (Leave empty to use automatic repository relative paths)
OCEAN_QC_DATA_DIR=
OCEAN_QC_OUTPUT_DIR=

# Execution Settings
OCEAN_QC_DPI=300
OCEAN_QC_RANDOM_SEED=42
OCEAN_QC_BOOTSTRAP_ITERS=1000

# Optional API / Proxy Settings for Public Data Downloader (If behind firewall)
HTTP_PROXY=
HTTPS_PROXY=
